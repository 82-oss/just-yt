---
// Opens the search modal. The dialog itself lives at body level in BaseLayout,
// not here — inside the sidebar it would be disabled by `inert` whenever the
// mobile drawer is shut, and the panel's transform would become its containing
// block. The script binds every [data-search-open] on the page.
---

<button class="trigger" type="button" data-search-open aria-label="Search documentation">
  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
  </svg>
  <span class="label">Search</span>
  <kbd class="hint"><span class="cmd">⌘</span>K</kbd>
</button>

<style>
  /* --- trigger ------------------------------------------------------- */

  .trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    width: 100%;
    padding: 0 8px 0 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--muted);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .trigger:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .trigger .icon {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .label {
    margin-right: auto;
  }

  .hint {
    display: flex;
    align-items: center;
    gap: 1px;
    padding: 2px 5px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.4;
  }

  .cmd {
    font-size: 12px;
  }
</style>
