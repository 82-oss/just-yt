---
import { docHref, type DocGroup } from '../lib/docs';

interface Props {
  groups: DocGroup[];
  pathname: string;
}

const { groups, pathname } = Astro.props;
const current = pathname.length > 1 ? pathname.replace(/\/$/, '') : pathname;
---

{/* Labels only. Five pages don't need glyphs to tell them apart, and a column
    of icons reads as decoration next to titles that already say the thing. */}
<nav class="doc-nav" aria-label="Documentation">
  {
    groups.map((group) => (
      <div class="group">
        <p class="group-heading">{group.name}</p>
        <ul>
          {group.docs.map((doc) => {
            const href = docHref(doc);
            const active = current === href;
            return (
              <li>
                <a href={href} class:list={['link', { active }]} aria-current={active ? 'page' : undefined}>
                  {doc.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  .group + .group {
    margin-top: 26px;
  }

  .group-heading {
    margin: 0 0 6px;
    padding-inline: 12px;
    color: var(--faint);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    display: block;
    overflow: hidden;
    padding: 7px 12px;
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .link:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  /*
   * The current page is a filled pill with a hairline ring. The ring is what
   * separates it from a hovered item — on a panel this dark the fill alone is
   * too close a match to read as "you are here" once the pointer moves away.
   */
  .link.active {
    background: var(--surface-hover);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--text);
    /* 600, not 550 — only 400/500/600/700 are loaded, so anything else is a
       synthesised weight that renders slightly heavier than it should. */
    font-weight: 600;
  }
</style>
