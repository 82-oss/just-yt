---
/**
 * The icon set.
 *
 * One monoline family at a single weight, so a chevron in the pager and the
 * drawer's menu button look like they came from the same hand. Every glyph is
 * drawn on a 24x24 grid, strokes only, and inherits `currentColor` — nothing
 * here carries its own colour or fill.
 *
 * Only glyphs the interface actually uses live here. Callout and copy glyphs
 * are duplicated in src/lib/markdown-plugins.mjs, which runs in the Markdown
 * processor and can't read an `.astro` file.
 *
 * Icons are inlined rather than sprited: there are seven of them and they cost
 * less as markup than as an extra request plus `<use>` plumbing.
 */
export type IconName =
  | 'check'
  | 'chevron-left'
  | 'chevron-right'
  | 'close'
  | 'copy'
  | 'external-link'
  | 'file-text'
  | 'github'
  | 'menu';

interface Props {
  name: IconName;
  /** Pixel size for both axes. */
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

/**
 * Paths only — the shared `<svg>` below owns the viewBox, stroke width and cap
 * style, so a glyph can never drift from the rest of the set.
 */
const PATHS: Record<IconName, string> = {
  // `copy` and `check` are the pair on a code block's copy button; the same two
  // are drawn again in src/lib/markdown-plugins.mjs for the docs' fenced blocks.
  check: '<path d="m4.5 12.6 4.8 4.7L19.5 6.8"/>',
  'chevron-left': '<path d="m14.5 5.5-6.2 6.5 6.2 6.5"/>',
  'chevron-right': '<path d="m9.5 5.5 6.2 6.5-6.2 6.5"/>',
  close: '<path d="M6 6 18 18"/><path d="M18 6 6 18"/>',
  copy: '<rect x="9" y="9" width="11" height="11" rx="2.6"/><path d="M15 5.6A2.6 2.6 0 0 0 12.4 4H6.6A2.6 2.6 0 0 0 4 6.6v5.8A2.6 2.6 0 0 0 5.6 15"/>',
  'external-link': '<path d="M13 5h6v6"/><path d="m19 5-8.5 8.5"/><path d="M18 14.5v3a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 5 17.5v-10A1.5 1.5 0 0 1 6.5 6h3"/>',
  'file-text': '<path d="M6.5 3.5h7l4 4v13h-11z"/><path d="M13.5 3.5v4h4"/><path d="M9.5 12h5"/><path d="M9.5 15.5h5"/>',
  // The only filled glyph in the set — the mark is unreadable as an outline.
  github:
    '<path fill="currentColor" stroke="none" d="M12 2.2a9.8 9.8 0 0 0-3.1 19.1c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.7.4-1.1.7-1.4-2.2-.2-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.8-4.6 5 .4.3.7 1 .7 2v2.9c0 .3.2.6.7.5A9.8 9.8 0 0 0 12 2.2Z"/>',
  menu: '<path d="M3.8 7h16.4"/><path d="M3.8 12h16.4"/><path d="M3.8 17h16.4"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
