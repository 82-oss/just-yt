---
// The search modal and its behaviour. Rendered once at body level so it is
// never affected by the sidebar's `inert` state or its transform.
// The index is fetched from /search.json on first open, so it costs nothing on
// pages where nobody searches.
---

<dialog class="dialog" data-search-dialog aria-label="Search documentation">
  <div class="field" role="search">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
    </svg>
    <input
      type="search"
      data-search-input
      placeholder="Search documentation…"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <kbd class="hint">Esc</kbd>
  </div>

  <div class="results" id="search-results" data-search-results role="listbox" aria-label="Search results"></div>

  <nav class="quick-links" data-search-quick-links aria-label="Quick links">
    <p class="quick-links-label">Quick links</p>
    <div class="quick-links-grid">
      <a href="/docs/getting-started">
        <span>Getting started</span>
        <small>Meet just-yt</small>
      </a>
      <a href="/docs/installation">
        <span>Installation</span>
        <small>Add it to your project</small>
      </a>
      <a href="/docs/search">
        <span>Search</span>
        <small>Find videos and channels</small>
      </a>
      <a href="/docs/api">
        <span>API reference</span>
        <small>Explore the full API</small>
      </a>
    </div>
  </nav>

  <p class="footer">
    <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
    <span><kbd>↵</kbd> to open</span>
  </p>
</dialog>

<style>
  /* --- dialog -------------------------------------------------------- */

  .dialog {
    width: min(720px, calc(100vw - 32px));
    max-height: min(620px, calc(100vh - 80px));
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .dialog::backdrop {
    background: var(--backdrop);
    backdrop-filter: blur(2px);
    animation: backdrop-in 0.24s ease-out both;
  }

  .dialog[open] {
    display: flex;
    flex-direction: column;
    animation: dialog-in 0.24s var(--ease) both;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(-14px) scale(0.97);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  .field {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
  }

  .field .icon {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--muted);
  }

  input {
    flex: 1;
    height: 48px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--text-md);
  }

  input:focus {
    outline: none;
  }

  input::placeholder {
    color: var(--muted);
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .results {
    flex: 1;
    padding: 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .results:empty {
    display: none;
  }

  .quick-links {
    padding: 18px 18px 20px;
  }

  .quick-links[hidden] {
    display: none;
  }

  .quick-links-label {
    margin: 0 0 10px;
    color: var(--faint);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .quick-links a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .quick-links a:hover {
    border-color: var(--line-strong);
    background: var(--surface-hover);
    transform: translateY(-1px);
  }

  .quick-links a span {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .quick-links a small {
    overflow: hidden;
    color: var(--muted);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .footer {
    display: flex;
    gap: 16px;
    flex: none;
    margin: 0;
    padding: 8px 14px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 11px;
  }

  .footer span {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .footer kbd {
    padding: 1px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--font-sans);
  }

  /* --- results (rendered by the script below) ------------------------ */

  .results :global(.result) {
    display: block;
    padding: 9px 11px;
    border-radius: var(--radius);
    cursor: pointer;
  }

  .results :global(.result[aria-selected='true']) {
    background: var(--soft);
  }

  .results :global(.result-title) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--text);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .results :global(.result-kind) {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .results :global(.result-context) {
    display: -webkit-box;
    margin-top: 2px;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .results :global(mark) {
    background: transparent;
    color: var(--accent);
    font-weight: 600;
  }

  .results :global(.empty) {
    padding: 24px 12px;
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (max-width: 800px) {
    .footer {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .dialog {
      margin-top: 16px;
    }

    .quick-links-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dialog[open],
    .dialog::backdrop {
      animation: none;
    }
  }
</style>

<script>
  interface SearchDoc {
    href: string;
    title: string;
    description: string;
    group: string;
    headings: Array<{ text: string; href: string }>;
    body: string;
  }

  interface Result {
    href: string;
    label: string;
    kind: string;
    context: string;
    score: number;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const list = document.querySelector<HTMLElement>('[data-search-results]');
  const quickLinks = document.querySelector<HTMLElement>('[data-search-quick-links]');

  if (dialog && input && list && quickLinks) {
    const MAX_RESULTS = 10;

    let index: SearchDoc[] | null = null;
    let indexRequest: Promise<SearchDoc[]> | null = null;
    let results: Result[] = [];
    let selected = 0;

    const loadIndex = () => {
      indexRequest ??= fetch('/search.json')
        .then((response) => (response.ok ? response.json() : []))
        .then((data: SearchDoc[]) => (index = data))
        .catch(() => (index = []));
      return indexRequest;
    };

    // --- scoring ---------------------------------------------------------

    const terms = (query: string) =>
      query
        .toLowerCase()
        .split(/\s+/)
        .filter((term) => term.length > 0);

    /**
     * Truncated term, so "cache" still finds "Caching" and "retry" finds
     * "Retries". Cheaper and less surprising than real stemming, and loose hits
     * are scored below exact ones so precision survives.
     */
    const stem = (term: string) => (term.length >= 5 ? term.slice(0, Math.max(4, term.length - 3)) : term);

    /** Weighted by where the term hit, exact ahead of loose. */
    const scoreField = (field: string, term: string, weight: number) => {
      if (field.includes(term)) return weight;
      const loose = stem(term);
      return loose !== term && field.includes(loose) ? weight * 0.6 : 0;
    };

    const matchesField = (field: string, term: string) => scoreField(field, term, 1) > 0;

    /** Every term must appear somewhere in the doc, or the doc is not a match. */
    const scoreDoc = (doc: SearchDoc, queryTerms: string[]) => {
      const title = doc.title.toLowerCase();
      const description = doc.description.toLowerCase();
      const headings = doc.headings.map((heading) => heading.text.toLowerCase()).join(' ');
      const body = doc.body.toLowerCase();

      let score = 0;
      for (const term of queryTerms) {
        const termScore =
          scoreField(title, term, 10) +
          scoreField(headings, term, 5) +
          scoreField(description, term, 3) +
          scoreField(body, term, 1);
        if (termScore === 0) return 0;
        score += termScore;
      }
      return score;
    };

    const snippet = (text: string, queryTerms: string[]) => {
      const lower = text.toLowerCase();
      let at = -1;
      for (const term of queryTerms) {
        const found = lower.includes(term) ? lower.indexOf(term) : lower.indexOf(stem(term));
        if (found !== -1 && (at === -1 || found < at)) at = found;
      }
      if (at === -1) return text.slice(0, 140);
      const start = Math.max(0, at - 45);
      const end = Math.min(text.length, at + 100);
      return `${start > 0 ? '…' : ''}${text.slice(start, end).trim()}${end < text.length ? '…' : ''}`;
    };

    const search = (query: string): Result[] => {
      const queryTerms = terms(query);
      if (queryTerms.length === 0 || !index) return [];

      const found: Result[] = [];

      for (const doc of index) {
        const score = scoreDoc(doc, queryTerms);
        if (score === 0) continue;

        found.push({
          href: doc.href,
          label: doc.title,
          kind: doc.group,
          context: doc.description,
          score,
        });

        const matchingHeadings = doc.headings
          .filter((heading) => queryTerms.some((term) => matchesField(heading.text.toLowerCase(), term)))
          .slice(0, 3);

        for (const heading of matchingHeadings) {
          found.push({
            href: heading.href,
            label: heading.text,
            kind: doc.title,
            context: snippet(doc.body, queryTerms),
            score: score + 4,
          });
        }
      }

      return found.sort((a, b) => b.score - a.score).slice(0, MAX_RESULTS);
    };

    // --- rendering -------------------------------------------------------

    /** Appends text with every query-term occurrence wrapped in a <mark>. */
    const appendHighlighted = (parent: HTMLElement, text: string, queryTerms: string[]) => {
      const lower = text.toLowerCase();
      const ranges: Array<[number, number]> = [];

      for (const term of queryTerms) {
        // Fall back to the stem so loose matches still get highlighted.
        const needle = lower.includes(term) ? term : stem(term);
        let from = 0;
        for (;;) {
          const at = lower.indexOf(needle, from);
          if (at === -1) break;
          ranges.push([at, at + needle.length]);
          from = at + needle.length;
        }
      }

      ranges.sort((a, b) => a[0] - b[0]);

      const merged: Array<[number, number]> = [];
      for (const range of ranges) {
        const last = merged.at(-1);
        if (last && range[0] <= last[1]) last[1] = Math.max(last[1], range[1]);
        else merged.push([range[0], range[1]]);
      }

      let cursor = 0;
      for (const [start, end] of merged) {
        if (start > cursor) parent.append(text.slice(cursor, start));
        const mark = document.createElement('mark');
        mark.textContent = text.slice(start, end);
        parent.append(mark);
        cursor = end;
      }
      if (cursor < text.length) parent.append(text.slice(cursor));
    };

    const render = (query: string) => {
      list.textContent = '';
      const queryTerms = terms(query);
      quickLinks.hidden = queryTerms.length > 0;

      if (queryTerms.length === 0) {
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        return;
      }

      if (results.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'empty';
        empty.textContent = `No results for “${query}”`;
        list.append(empty);
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        return;
      }

      results.forEach((result, position) => {
        const item = document.createElement('a');
        item.className = 'result';
        item.id = `search-result-${position}`;
        item.href = result.href;
        item.setAttribute('role', 'option');
        item.setAttribute('aria-selected', String(position === selected));

        const title = document.createElement('span');
        title.className = 'result-title';
        const label = document.createElement('span');
        appendHighlighted(label, result.label, queryTerms);
        const kind = document.createElement('span');
        kind.className = 'result-kind';
        kind.textContent = result.kind;
        title.append(label, kind);

        const context = document.createElement('span');
        context.className = 'result-context';
        appendHighlighted(context, result.context, queryTerms);

        item.append(title, context);
        item.addEventListener('mousemove', () => setSelected(position));
        list.append(item);
      });

      input.setAttribute('aria-expanded', 'true');
      input.setAttribute('aria-activedescendant', `search-result-${selected}`);
    };

    const setSelected = (position: number) => {
      if (results.length === 0) return;
      selected = (position + results.length) % results.length;

      list.querySelectorAll<HTMLElement>('.result').forEach((item, itemPosition) => {
        item.setAttribute('aria-selected', String(itemPosition === selected));
      });

      list.children[selected]?.scrollIntoView({ block: 'nearest' });
      input.setAttribute('aria-activedescendant', `search-result-${selected}`);
    };

    const update = () => {
      results = search(input.value);
      selected = 0;
      render(input.value);
    };

    // --- open / close ----------------------------------------------------

    const open = async () => {
      if (dialog.open) return;
      dialog.showModal();
      input.focus();
      await loadIndex();
      if (input.value) update();
    };

    for (const trigger of document.querySelectorAll('[data-search-open]')) {
      trigger.addEventListener('click', open);
    }

    document.addEventListener('keydown', (event) => {
      const isShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
      const target = event.target as HTMLElement | null;
      const isTyping =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target?.isContentEditable === true;

      if (isShortcut || (event.key === '/' && !isTyping && !dialog.open)) {
        event.preventDefault();
        void open();
      }
    });

    dialog.addEventListener('close', () => {
      input.value = '';
      results = [];
      selected = 0;
      render('');
    });

    // Clicking the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    input.addEventListener('input', update);

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setSelected(selected + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setSelected(selected - 1);
      } else if (event.key === 'Enter') {
        const target = results[selected];
        if (target) {
          event.preventDefault();
          dialog.close();
          window.location.href = target.href;
        }
      }
    });
  }
</script>
