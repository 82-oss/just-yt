---
// Drives <html data-sidebar>. On desktop the panel slides out and the content
// animates across the space; below 1000px the same state opens the drawer.
---

<button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="docs-sidebar" aria-expanded="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2.5"></rect>
    <line x1="9.5" y1="4" x2="9.5" y2="20"></line>
  </svg>
</button>

<style>
  .sidebar-toggle {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .sidebar-toggle:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  .sidebar-toggle svg {
    width: 16px;
    height: 16px;
  }

  /* The divider fades out to read as "panel hidden". */
  .sidebar-toggle line {
    transition: opacity 0.2s ease;
  }

  :global(:root[data-sidebar='collapsed']) .sidebar-toggle line {
    opacity: 0.25;
  }
</style>

<script>
  const STORAGE_KEY = 'just-yt-sidebar';
  const MOBILE = '(max-width: 1000px)';
  const root = document.documentElement;

  const sidebar = document.getElementById('docs-sidebar');
  const scrim = document.querySelector<HTMLElement>('[data-sidebar-scrim]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sidebar-toggle]');

  const isCollapsed = () => root.dataset.sidebar === 'collapsed';

  const sync = () => {
    const collapsed = isCollapsed();
    for (const button of buttons) {
      button.setAttribute('aria-expanded', String(!collapsed));
      button.setAttribute('aria-label', collapsed ? 'Show sidebar' : 'Hide sidebar');
    }
    // Keep the off-screen panel out of the tab order without unmounting it.
    if (sidebar) sidebar.inert = collapsed;
  };

  const set = (collapsed: boolean, remember: boolean) => {
    root.dataset.sidebar = collapsed ? 'collapsed' : 'expanded';
    // The drawer is a transient overlay, so its state isn't worth persisting.
    if (remember) localStorage.setItem(STORAGE_KEY, root.dataset.sidebar);
    sync();
  };

  for (const button of buttons) {
    button.addEventListener('click', () => set(!isCollapsed(), !matchMedia(MOBILE).matches));
  }

  scrim?.addEventListener('click', () => set(true, false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && matchMedia(MOBILE).matches && !isCollapsed()) set(true, false);
  });

  // Crossing the breakpoint: restore the saved desktop state, and never leave
  // the drawer stranded open on the way down.
  matchMedia(MOBILE).addEventListener('change', (event) => {
    set(event.matches || localStorage.getItem(STORAGE_KEY) === 'collapsed', false);
  });

  sync();
</script>
