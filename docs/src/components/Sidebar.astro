---
import DrawerToggle from './DrawerToggle.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SearchTrigger from './SearchTrigger.astro';
import SidebarNav from './SidebarNav.astro';
import type { DocGroup } from '../lib/docs';
import { GITHUB_REPO } from '../lib/site';
import { VERSION } from '../lib/version';

interface Props {
  groups: DocGroup[];
  pathname: string;
}

const { groups, pathname } = Astro.props;
---

{/* Permanent on desktop — there is nothing to collapse it with any more. Below
    1000px the same panel slides in as a drawer, which is the one width where
    276px of navigation genuinely is in the way. */}
<aside class="sidebar" id="docs-sidebar">
  <div class="head">
    <a class="brand" href="/" aria-label="just-yt home">
      <Logo />
    </a>

    <div class="head-actions">
      {/* An open drawer covers the topbar's copy of this button, so the panel
          carries its own. Hidden above the breakpoint, where it has no job. */}
      <DrawerToggle />
    </div>
  </div>

  <div class="search-slot">
    <SearchTrigger />
  </div>

  <div class="scroller">
    <SidebarNav groups={groups} pathname={pathname} />
  </div>
  <div class="scroll-indicator" data-sidebar-scroll-indicator aria-hidden="true">
    <span data-sidebar-scroll-thumb></span>
  </div>

  <footer class="foot">
    <span class="version">v{VERSION}</span>
    <a class="repo" href={GITHUB_REPO} rel="noreferrer noopener" target="_blank">
      <Icon name="github" size={14} />
      GitHub
    </a>
  </footer>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    width: var(--sidebar-w);
    background: transparent;
  }

  .head {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    height: var(--topbar-h);
    width: var(--sidebar-inner-w);
    margin-left: auto;
    margin-right: var(--sidebar-right-gap);
    padding: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    min-width: 0;
    border-radius: var(--radius-sm);
  }

  .head-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2px;
  }

  .search-slot {
    flex: none;
    width: var(--sidebar-inner-w);
    margin-left: auto;
    margin-right: var(--sidebar-right-gap);
    padding: 6px 0 18px;
  }

  .scroller {
    flex: 1;
    min-height: 0;
    /* Pulled in so the nav pills' padding lines up with the search field above
       them, rather than the pills themselves. */
    width: calc(var(--sidebar-inner-w) + 24px);
    margin-left: auto;
    margin-right: calc(var(--sidebar-right-gap) - 12px);
    padding: 0 0 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .scroller::-webkit-scrollbar {
    display: none;
  }

  .scroll-indicator {
    position: absolute;
    top: calc(var(--topbar-h) + 62px);
    right: 5px;
    bottom: 52px;
    width: 3px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s ease;
  }

  .scroll-indicator[data-visible] {
    opacity: 1;
  }

  .scroll-indicator span {
    position: absolute;
    inset: 0 0 auto;
    min-height: 28px;
    border-radius: var(--radius-pill);
    background: var(--line-hover);
    will-change: height, transform;
  }

  .foot {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: var(--sidebar-inner-w);
    margin-left: auto;
    margin-right: var(--sidebar-right-gap);
    padding: 12px 0;
    font-size: var(--text-xs);
  }

  .version {
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--faint);
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }

  .repo {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .repo:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  /* As a drawer the panel floats above the content, slides, and casts a
     shadow — the only place the open/close motion survives. */
  @media (max-width: 1000px) {
    .sidebar {
      width: min(var(--sidebar-w), 88vw);
      background: var(--bg);
      box-shadow: var(--shadow);
      transition: transform var(--duration) var(--ease);
    }

    .head,
    .search-slot,
    .foot {
      width: auto;
      margin-inline: var(--sidebar-pad);
    }

    .scroller {
      width: auto;
      margin-inline: calc(var(--sidebar-pad) - 12px);
    }

    :global(:root:not([data-drawer='open'])) .sidebar {
      transform: translateX(-100%);
    }
  }
</style>

<script>
  const scroller = document.querySelector<HTMLElement>('#docs-sidebar .scroller');
  const indicator = document.querySelector<HTMLElement>('[data-sidebar-scroll-indicator]');
  const thumb = indicator?.querySelector<HTMLElement>('[data-sidebar-scroll-thumb]');

  if (scroller && indicator && thumb) {
    let hideTimer: number | undefined;

    const updateThumb = () => {
      const viewport = scroller.clientHeight;
      const content = scroller.scrollHeight;
      const track = indicator.clientHeight;

      if (content <= viewport || track <= 0) {
        indicator.removeAttribute('data-visible');
        return;
      }

      const height = Math.max(28, track * (viewport / content));
      const progress = scroller.scrollTop / Math.max(1, content - viewport);
      const top = progress * (track - height);

      thumb.style.height = `${height}px`;
      thumb.style.transform = `translateY(${top}px)`;
    };

    const reveal = () => {
      updateThumb();
      indicator.setAttribute('data-visible', '');
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => indicator.removeAttribute('data-visible'), 700);
    };

    scroller.addEventListener('scroll', reveal, { passive: true });
    window.addEventListener('resize', updateThumb, { passive: true });
    updateThumb();
  }
</script>
