---
/**
 * The just-yt mark: a geometric monoline "y" drawn with two strokes.
 *
 * An abstract letterform rather than a play button or media glyph, so it
 * doesn't borrow anyone else's iconography. The long stroke runs through the
 * junction to form the tail, which keeps it two lines — legible at 16px.
 * Monochrome, so it inherits whatever the surrounding text colour is.
 */
interface Props {
  /** Hides the wordmark, e.g. for tight layouts. */
  markOnly?: boolean;
}

const { markOnly = false } = Astro.props;
---

<span class="logo">
  <svg
    class="mark"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M6.9 4.75 12 11.9"></path>
    <path d="M17.5 4.75 7.6 19.25"></path>
  </svg>
  {!markOnly && <span class="wordmark">just-yt</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
  }

  .mark {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .wordmark {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
</style>
