---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page doesn't exist.">
  <main id="main" class="page">
    <p class="eyebrow">404</p>
    <h1>That page doesn’t exist.</h1>
    <p class="lead">The link may be out of date, or the page may have moved.</p>
    <div class="actions">
      <a class="button primary" href="/">Getting started</a>
      <a class="button" href="/docs/api">API reference</a>
    </div>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(56px, 12vh, 128px) var(--content-pad) 112px;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .lead {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
</style>
