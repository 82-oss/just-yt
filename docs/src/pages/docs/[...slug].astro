---
import DocPage from '../../components/DocPage.astro';
import { getSortedDocs, HOME_DOC_ID } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = await getSortedDocs();
  return docs
    // The first doc lives at `/` (src/pages/index.astro). Building it here too
    // would give it two URLs, and shadow the redirect that keeps its old one
    // working.
    .filter((doc) => doc.id !== HOME_DOC_ID)
    .map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
---

<DocPage doc={doc} />
