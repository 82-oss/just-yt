---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import CodeChrome from '../components/CodeChrome.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;

const showToc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 1;
---

<BaseLayout title={title} description={description}>
  <div class:list={['shell', { 'with-toc': showToc }]}>
    <main id="main">
      <slot />
    </main>

    {
      showToc && (
        <aside class="toc-rail">
          <TableOfContents headings={headings} />
        </aside>
      )
    }
  </div>

  <CodeChrome />
</BaseLayout>

<style>
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 6vw, 80px);
    padding: clamp(32px, 5vh, 56px) var(--content-pad) 88px;
  }

  .shell.with-toc {
    grid-template-columns: minmax(0, 1fr) var(--toc-w);
  }

  main {
    /* Explicit, because the auto margins below opt the grid item out of
       stretching: without it the article is shrink-to-fit and overflows the
       column on narrow screens instead of wrapping inside it. */
    width: 100%;
    min-width: 0;
    max-width: var(--content-max);
    /* Keeps the article centred in the leftover space instead of hugging the
       sidebar, so wide screens don't read as lopsided. */
    margin-inline: auto;
  }

  /*
   * The table of contents goes first — the page content matters more. The
   * cutoff is the width at which the sidebar, a full-measure article and the
   * rail all fit; the sidebar is permanent now, so it is a single fixed number
   * rather than something that moves with a panel's state.
   */
  @media (max-width: 1279px) {
    .shell.with-toc {
      grid-template-columns: minmax(0, 1fr);
    }

    .toc-rail {
      display: none;
    }
  }
</style>
