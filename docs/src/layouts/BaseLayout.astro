---
import { Font } from 'astro:assets';
import DrawerToggle from '../components/DrawerToggle.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Sidebar from '../components/Sidebar.astro';
import { docHref, getDocGroups } from '../lib/docs';
import { VERSION } from '../lib/version';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const groups = await getDocGroups();
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? Astro.url.origin);
const pageTitle = `${title} — just-yt`;

// The topbar shows where you are rather than sitting empty: with the sidebar
// permanent, the only thing it used to hold was a button to hide it.
const current = pathname.length > 1 ? pathname.replace(/\/$/, '') : pathname;
const section = groups.find((group) => group.docs.some((doc) => docHref(doc) === current));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="just-yt" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    {/* Restores the theme before first paint: no flash, and no transition fires
        because the value never changes after styles resolve. The drawer is not
        restored — it always starts closed. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.drawer = 'closed';
        try {
          const theme = localStorage.getItem('just-yt-theme');
          root.dataset.theme =
            theme === 'light' || theme === 'dark'
              ? theme
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
        } catch {
          root.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Sidebar groups={groups} pathname={pathname} />
    <div class="scrim" data-drawer-scrim aria-hidden="true"></div>
    <SearchDialog />

    <div class="content">
      <div class="topbar">
        <DrawerToggle />

        <a class="topbar-brand" href="/" aria-label="just-yt home">
          <Logo />
        </a>

        {
          section && (
            <nav class="crumbs" aria-label="Breadcrumb">
              <span class="crumb-section">{section.name}</span>
              <span class="crumb-sep" aria-hidden="true">
                /
              </span>
              <span class="crumb-page">{title}</span>
            </nav>
          )
        }

        <a
          class="topbar-repo"
          href="https://github.com/spheceo/just-yt"
          rel="noreferrer noopener"
          target="_blank"
          aria-label="just-yt on GitHub"
        >
          <Icon name="github" />
        </a>
      </div>

      <slot />

      <footer class="site-footer">
        <span>just-yt v{VERSION}</span>
        <span>MIT license</span>
      </footer>
    </div>

    <style>
      .content {
        padding-left: var(--sidebar-w);
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        align-items: center;
        gap: 10px;
        height: var(--topbar-h);
        padding: 0 var(--content-pad);
        border-bottom: 1px solid transparent;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(12px);
      }

      /* The rule only appears once there is content scrolled under the bar, so
         a page sitting at the top reads as one uninterrupted surface. */
      .topbar[data-stuck] {
        border-bottom-color: var(--line);
      }

      /* The sidebar already shows the logo whenever it is on screen. */
      .topbar-brand {
        display: none;
        align-items: center;
        border-radius: var(--radius-sm);
      }

      .crumbs {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        margin-right: auto;
        color: var(--faint);
        font-size: var(--text-sm);
      }

      .crumb-page {
        overflow: hidden;
        color: var(--muted);
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .topbar-repo {
        display: grid;
        place-items: center;
        flex: none;
        width: 32px;
        height: 32px;
        margin-left: auto;
        border-radius: var(--radius-sm);
        color: var(--muted);
        transition:
          background-color 0.15s ease,
          color 0.15s ease;
      }

      .topbar-repo:hover {
        background: var(--surface-hover);
        color: var(--text);
      }

      .scrim {
        position: fixed;
        inset: 0;
        z-index: 45;
        background: var(--backdrop);
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--duration) var(--ease);
      }

      .site-footer {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-top: 32px;
        padding: 24px var(--content-pad);
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: var(--text-xs);
      }

      @media (max-width: 1000px) {
        /* The panel becomes an overlay, so the content stops reserving space. */
        .content {
          padding-left: 0;
        }

        .topbar-brand {
          display: flex;
        }

        /* Both the logo and the trail is more than a phone-width bar can hold. */
        .crumbs {
          display: none;
        }

        :root[data-drawer='open'] .scrim {
          opacity: 1;
          pointer-events: auto;
        }
      }
    </style>

    <script>
      // Toggles the topbar's hairline. An IntersectionObserver on a sentinel is
      // cheaper than a scroll listener and doesn't need throttling.
      const topbar = document.querySelector<HTMLElement>('.topbar');

      if (topbar) {
        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px';
        document.body.prepend(sentinel);

        new IntersectionObserver(([entry]) => topbar.toggleAttribute('data-stuck', !entry.isIntersecting)).observe(
          sentinel,
        );
      }
    </script>
  </body>
</html>
